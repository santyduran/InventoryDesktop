# Copia este archivo como .env y complétalo. El .env NUNCA se sube a git.

# Nombre corto del cliente (identifica los contenedores y volúmenes).
CLIENTE=mi-cliente

# Dominio público, ya apuntando a este servidor (registro DNS tipo A).
DOMAIN=inventario.ejemplo.com

# Genera cada secreto con:  openssl rand -hex 48
JWT_SECRET=
# Código que se pide al crear el primer administrador.
# Genéralo con:  openssl rand -hex 12   y entrégaselo solo al cliente.
SETUP_TOKEN=

# Duración de la sesión (15m, 8h, 12h, 1d...).
JWT_EXPIRES_IN=12h

# Configuración de marca del cliente. Usa la ruta del archivo que pongas en marca/.
APP_CONFIG_PATH=/marca/app-config.json

# Puertos del servidor (normalmente 80 y 443).
HTTP_PORT=80
HTTPS_PORT=443
